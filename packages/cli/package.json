{
  "name": "kira-kit",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "CLI for Kira Kit — a shadcn-compatible registry of Base UI components, plus OKLCH theme generation and quality checks",
  "type": "module",
  "bin": {
    "kira-kit": "dist/index.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test --config ../../oxlint.config.ts --ignore-pattern \"test/fixtures/**\"",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [
    "kira-kit",
    "shadcn",
    "ui-components",
    "base-ui",
    "registry",
    "oklch",
    "theme",
    "cli",
    "react",
    "tailwind"
  ],
  "author": "Kiranaide",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "apca-w3": "^0.1.9",
    "commander": "^15.1.0",
    "culori": "^4.0.2",
    "package-manager-detector": "^1.9.0",
    "picocolors": "^1.1.1",
    "shadcn": "4.22.1",
    "typescript": "^5.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^3.0.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.0.0",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.0"
  }
}
