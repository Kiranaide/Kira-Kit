# Rendered by the stock nginx entrypoint (envsubst) into conf.d/default.conf.
# PORT lets Coolify (or any host) pick the container listen port; defaults to 80.
# nginx runtime variables like $uri are left untouched — only defined env vars
# (PORT) are substituted.
# Preserve the external scheme when running behind a reverse proxy (e.g. Coolify).
map $http_x_forwarded_proto $public_scheme {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# Keep staging/dev deployments out of search indexes while main stays indexable.
map $http_host $robots_header {
    default "";
    ~*^kit-dev\. "noindex, nofollow";
}

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Robots-Tag $robots_header always;

    # Agent index — render as plain text and qualify relative /docs/ links
    # with the live request origin so any deployment domain works dynamically.
    location = /llms.txt {
        default_type text/plain;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "no-cache" always;
        add_header Vary "Host, X-Forwarded-Proto" always;
        sub_filter_types text/plain;
        sub_filter_once off;
        sub_filter '](/docs/' ']($public_scheme://$http_host/docs/';
    }

    # Per-item agent docs — render as plain text in the browser
    location ~ ^/docs/.*\.md$ {
        default_type text/plain;
        add_header Access-Control-Allow-Origin "*" always;
    }

    # Registry JSON — consumed by remote `kira-kit add` fetches.
    # Never cached so consumers always get the latest items.
    location /r/ {
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "no-cache" always;
    }

    # Hashed build assets are immutable
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Showcase app SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types application/json text/plain text/css application/javascript image/svg+xml;
    gzip_min_length 1024;
}